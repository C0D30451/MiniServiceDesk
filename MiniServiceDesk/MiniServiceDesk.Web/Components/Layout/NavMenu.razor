@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@inject MiniServiceDesk.Web.Services.AuthState Auth
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@implements IDisposable

@{
    var isAgentOrAdmin = Auth.IsInRole("Agent") || Auth.IsInRole("Admin");
    var isAdmin = Auth.IsInRole("Admin");
}

<nav class="topbar shadow-sm bg-dark">
    <div class="container-fluid d-flex flex-column align-items-start gap-3 py-3">
        <!-- Brand / Logo -->
        <a class="brand text-white fw-semibold" href="/">
            Mini Service Desk
        </a>

        <!-- Links principali -->
        <ul class="nav flex-column gap-2 w-100">
            <li class="nav-item">
                <Microsoft.AspNetCore.Components.Routing.NavLink class="nav-link link-light" href="">

                    <i class="bi-house-fill"></i>
                    <span class="ms-1">Home</span>
                </Microsoft.AspNetCore.Components.Routing.NavLink>
            </li>
            <li class="nav-item">
                <NavLink class="nav-link link-light" href="tickets">
                    <i class="bi-table"></i>
                    <span class="ms-1">Ticket</span>
                </NavLink>
            </li>

            @if (isAgentOrAdmin)
            {
                <li class="nav-item">
                    <NavLink class="nav-link link-light" href="tickets/all">
                        <i class="bi-kanban"></i>
                        <span class="ms-1">All Tickets</span>
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link link-light" href="dashboard/agents">
                        <i class="bi-people"></i>
                        <span class="ms-1">Agent Workload</span>
                    </NavLink>
                </li>
            }

            @if (isAdmin)
            {
                <li class="nav-item">
                    <NavLink class="nav-link link-light" href="admin/config">
                        <i class="bi-gear"></i>
                        <span class="ms-1">Admin Config</span>
                    </NavLink>
                </li>
            }

            @if (Auth.IsAuthenticated)
            {
                <li class="nav-item">
                    <NavLink class="nav-link link-light" href="notifications">
                        <i class="bi-bell"></i>
                        <span class="ms-1">Notifications</span>
                        @if (_unreadCount > 0)
                        {
                            <span class="notification-badge">@_unreadCount</span>
                        }
                    </NavLink>
                </li>
            }

            <li class="nav-item">
                <NavLink class="nav-link link-light" href="login">
                    <i class="bi-person-circle"></i>
                    <span class="ms-1">Login</span>
                </NavLink>
            </li>
        </ul>

        <!-- CTA: nuovo ticket -->
        <NavLink class="btn btn-sm btn-outline-light w-100 text-start" href="tickets/new">
            <i class="bi-plus-circle"></i>
            <span class="ms-1">Nuovo ticket</span>
        </NavLink>
    </div>
</nav>

@code {
    private int _unreadCount;

    protected override void OnInitialized()
    {
        Auth.OnChange += HandleAuthChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
        _ = LoadUnreadCountAsync();
    }

    private void HandleAuthChanged()
    {
        _ = LoadUnreadCountAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = LoadUnreadCountAsync();
    }

    private async Task LoadUnreadCountAsync()
    {
        if (!Auth.IsAuthenticated || string.IsNullOrWhiteSpace(Auth.Token))
        {
            _unreadCount = 0;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("Api");
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Token);

            var response = await client.GetAsync("api/notifications/unread-count");
            if (!response.IsSuccessStatusCode)
            {
                _unreadCount = 0;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var body = await response.Content.ReadFromJsonAsync<UnreadCountDto>();
            _unreadCount = body?.Count ?? 0;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _unreadCount = 0;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Auth.OnChange -= HandleAuthChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private sealed class UnreadCountDto
    {
        public int Count { get; set; }
    }
}
