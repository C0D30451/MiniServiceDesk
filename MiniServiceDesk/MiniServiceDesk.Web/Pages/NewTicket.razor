@page "/tickets/new"
@namespace MiniServiceDesk.Web.Pages
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject MiniServiceDesk.Web.Services.AuthState Auth

<h3 class="page-title">New ticket</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <p style="color:red">@_error</p>
}

<div>
    <label style="color:#f4f8ff">Title</label><br />
    <input @bind="_model.Title" required minlength="4" maxlength="120" />
</div>

<div style="margin-top:8px">
    <label style="color:#f4f8ff">Description</label><br />
    <textarea @bind="_model.Description" rows="6" cols="60" required minlength="10" maxlength="4000"></textarea>
</div>

<div style="margin-top:8px">
    <label style="color:#f4f8ff">Category</label><br />
    <input @bind="_model.Category" />
</div>

<div style="margin-top:8px">
    <label style="color:#f4f8ff">Priority (0 Low, 1 Medium, 2 High, 3 Critical)</label><br />
    <input type="number" @bind="_model.Priority" />
</div>

<div style="margin-top:8px">
    <label style="color:#f4f8ff">Due date (optional)</label><br />
    <input type="datetime-local" @bind="_dueAtLocal" />
</div>

<div style="margin-top:12px">
    <button type="button" @onclick="HandleSaveClick">Save</button>
    <a href="/tickets" style="margin-left:8px">Cancel</a>
</div>
