@page "/tickets/new"
@rendermode Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<h3>New ticket</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <p style="color:red">@_error</p>
}

<div>
    <label>Title</label><br />
    <input @bind="_model.Title" />
</div>

<div style="margin-top:8px">
    <label>Description</label><br />
    <textarea @bind="_model.Description" rows="6" cols="60"></textarea>
</div>

<div style="margin-top:8px">
    <label>Category</label><br />
    <input @bind="_model.Category" />
</div>

<div style="margin-top:8px">
    <label>Priority (0 Low, 1 Medium, 2 High, 3 Critical)</label><br />
    <input type="number" @bind="_model.Priority" />
</div>

<div style="margin-top:12px">
    <button type="button" @onclick="Save">Save</button>
    <button type="button" style="margin-left:8px" @onclick="Cancel">Cancel</button>
</div>
