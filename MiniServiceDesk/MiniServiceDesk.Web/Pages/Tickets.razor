@page "/tickets"
@inject IHttpClientFactory HttpClientFactory
@inject MiniServiceDesk.Web.Services.AuthState Auth
@inject NavigationManager Nav

<section class="page-shell">
    <div class="page-head">
        <h3 class="page-title">Tickets</h3>
        <a class="btn btn-primary page-cta" href="/tickets/new">+ New ticket</a>
    </div>

    @if (_tickets is null)
    {
        <p class="panel">Loading...</p>
    }
    else if (_tickets.Count == 0)
    {
        <p class="panel">No tickets yet.</p>
    }
    else
    {
        <div class="ticket-grid">
            @foreach (var t in _tickets.OrderBy(t => t.Id))
            {
                <article class="ticket-card">
                    <div class="ticket-card-head">
                        <a class="ticket-title-link" href="/tickets/@t.Id">@t.Title</a>
                        <span class="status-pill @StatusCss(t.Status)">@StatusLabel(t.Status)</span>
                    </div>
                    <div class="ticket-meta">
                        <span class="priority-pill @PriorityCss(t.Priority)">@PriorityLabel(t.Priority)</span>
                        <span class="meta-dot">•</span>
                        <span>@t.Category</span>
                        <span class="meta-dot">•</span>
                        <span>#@t.Id</span>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private List<TicketDto>? _tickets;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var client = HttpClientFactory.CreateClient("Api");
        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Token);

        var response = await client.GetAsync("api/tickets");
        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Auth.Clear();
            Nav.NavigateTo("/login");
            return;
        }

        response.EnsureSuccessStatusCode();
        _tickets = await response.Content.ReadFromJsonAsync<List<TicketDto>>() ?? new List<TicketDto>();
    }

    private static string StatusLabel(int status) => status switch
    {
        0 => "Open",
        1 => "In Progress",
        2 => "Waiting",
        3 => "Resolved",
        4 => "Closed",
        _ => $"Unknown ({status})"
    };

    private static string StatusCss(int status) => status switch
    {
        0 => "status-open",
        1 => "status-progress",
        2 => "status-waiting",
        3 => "status-resolved",
        4 => "status-closed",
        _ => "status-unknown"
    };

    private static string PriorityLabel(int priority) => priority switch
    {
        0 => "Low",
        1 => "Medium",
        2 => "High",
        3 => "Critical",
        _ => $"P{priority}"
    };

    private static string PriorityCss(int priority) => priority switch
    {
        0 => "prio-low",
        1 => "prio-medium",
        2 => "prio-high",
        3 => "prio-critical",
        _ => "prio-unknown"
    };

    private class TicketDto
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Category { get; set; } = "";
        public int Priority { get; set; }
        public int Status { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }
}
