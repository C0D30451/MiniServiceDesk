@* layout condiviso per l’intera app Blazor Server *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Mini Service Desk</title>
    <base href="~/" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />

    <!-- Bootstrap (già incluso nel template Blazor) -->
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- stile generato da dotnet watch -->
