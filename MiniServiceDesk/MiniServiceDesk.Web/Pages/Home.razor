@page "/"

@inject NavigationManager Nav

<!-- Hero section -->
<div class="py-5 bg-primary text-white text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">Mini Service Desk</h1>
        <p class="lead mb-0">Gestisci le richieste interne in modo semplice e veloce.</p>
    </div>
</div>

<!-- Feature cards -->
<div class="container my-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title fw-semibold">Creazione Ticket</h5>
                    <p class="card-text">Apri un nuovo ticket in pochi secondi e allega tutti i dettagli necessari.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title fw-semibold">Monitoraggio Stato</h5>
                    <p class="card-text">Segui l'avanzamento delle tue richieste con aggiornamenti in tempo reale.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title fw-semibold">Dashboard Agenti</h5>
                    <p class="card-text">Gli operatori hanno una vista dedicata per gestire la coda e risolvere i ticket in modo efficiente.</p>
                </div>
            </div>
        </div>
    </div>
</div>